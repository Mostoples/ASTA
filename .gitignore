# ---- Dependensi ----
node_modules/

# ---- Cache deploy Firebase ----
# Dibuat ulang setiap `firebase deploy`; tidak bermakna di dalam riwayat.
.firebase/

# ---- Berkas cadangan otomatis ----
# Blender menulis .blend1 tiap menyimpan; alat CapCut menulis .bak.
*.blend1
*.bak

# ---- Sampah sistem operasi ----
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# ---- Log ----
*.log
firebase-debug.log

# ---- Frame mentah showreel ----
# Tiap varian menghasilkan ~1,5 GB frame JPEG perantara. Berkas ini
# dapat dibuat ulang kapan saja dengan `node tools/showreel/record.js`,
# jadi yang disimpan hanyalah klip dan video jadinya.
video-showreel/

# ---- Perantara showreel ----
# Klip per adegan hanya bahan rakitan; proyek CapCut sudah menyimpan
# salinannya sendiri di assets/video/, dan build.js membuatnya ulang
# dari frame kapan pun diperlukan.
video-showreel-clips/

# Riwayat undo capcut-cli, bukan bagian proyeknya.
.capcut-cli-history/

# ---- Rekaman kamera mentah ----
# Video dokumentasi dari ponsel beserta hasil konversinya; ukurannya
# ratusan MB sampai GB dan bukan bagian dari kode aplikasi.
ASTA rekaman/
ASTA rekaman MP4/
ASTA REKAMAN FIX/
ASTA REKAMAN FIX MP4/

# ---- Video semifinal ----
# Hasil build.py (±160 MB) dan dapat dibangun ulang dari materi rekaman;
# yang disimpan hanyalah skrip perakitnya di tools/asta-video/.
ASTA - Video Semifinal HRIE 2026.mp4
